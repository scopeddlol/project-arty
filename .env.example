# Copy to .env to override the docker-compose.yml defaults.

# Host port the calculator is published on.
WARDOGS_PORT=8080

# Where map tiles and Terrain3D data are fetched from. The container proxies
# and caches them under /cdn/, so browsers never talk to this host directly.
ASSET_UPSTREAM=https://assets.wardogs-artillery.com

# Maximum disk space for the local tile/terrain cache (nginx size syntax).
CDN_CACHE_MAX_SIZE=2g
