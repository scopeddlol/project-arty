#!/bin/sh
# Sourced by the nginx image entrypoint before templates are rendered.
# Runs after 15-local-resolvers.envsh, which sets NGINX_LOCAL_RESOLVERS.

ASSET_UPSTREAM="${ASSET_UPSTREAM%/}"
case "$ASSET_UPSTREAM" in
    http://?*|https://?*) ;;
    *)
        echo "arty: ASSET_UPSTREAM must be an http(s):// URL, got '$ASSET_UPSTREAM'" >&2
        exit 1
        ;;
esac
export ASSET_UPSTREAM

case "$CDN_CACHE_MAX_SIZE" in
    [0-9]*) ;;
    *)
        echo "arty: CDN_CACHE_MAX_SIZE must look like 2g or 500m, got '$CDN_CACHE_MAX_SIZE'" >&2
        exit 1
        ;;
esac

# Containers without nameservers in resolv.conf still need a resolver for
# the CDN proxy.
if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ]; then
    export NGINX_LOCAL_RESOLVERS="1.1.1.1 8.8.8.8"
fi
